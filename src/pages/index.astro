---
const title = 'Site Ops Blog';
const modules = import.meta.glob('../../content/posts/**/*.md', { eager: true });
const posts = Object.entries(modules).map(([file, mod]) => ({
  file,
  href: `/${file
    .replace('../../content/posts/', '')
    .replace(/\.md$/, '')}`,
  frontmatter: mod.frontmatter ?? {},
}));
---
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <title>{title}</title>
    <style>
      :root {
        color-scheme: light;
        --bg: #f7f5ef;
        --surface: #fffdf8;
        --text: #1d1d1b;
        --muted: #686457;
        --border: #d9d1bf;
        --accent: #1849d6;
        --accent-strong: #1037a6;
      }

      * {
        box-sizing: border-box;
      }

      body {
        margin: 0;
        font-family: "Noto Serif SC", "Songti SC", "STSong", serif;
        background: linear-gradient(180deg, #f3efe5 0%, var(--bg) 100%);
        color: var(--text);
      }

      main {
        width: min(760px, calc(100vw - 32px));
        margin: 0 auto;
        padding: 56px 0 72px;
      }

      h1 {
        margin: 0 0 12px;
        font-size: clamp(2rem, 5vw, 3rem);
      }

      p {
        margin: 0 0 28px;
        color: var(--muted);
        line-height: 1.7;
      }

      ul {
        margin: 0;
        padding: 0;
        list-style: none;
      }

      li + li {
        margin-top: 14px;
      }

      a {
        display: block;
        padding: 18px 20px;
        border: 1px solid var(--border);
        border-radius: 16px;
        background: var(--surface);
        color: inherit;
        text-decoration: none;
        transition:
          transform 140ms ease,
          border-color 140ms ease,
          box-shadow 140ms ease,
          color 140ms ease,
          background-color 140ms ease;
      }

      a:hover {
        color: var(--accent);
        border-color: rgba(24, 73, 214, 0.35);
        box-shadow: 0 14px 32px rgba(24, 73, 214, 0.1);
        transform: translateY(-2px);
      }

      a:focus-visible {
        outline: 3px solid rgba(24, 73, 214, 0.24);
        outline-offset: 3px;
        border-color: var(--accent);
      }

      a:active {
        transform: translateY(0) scale(0.985);
        color: var(--accent-strong);
        background: #f5f8ff;
        box-shadow: inset 0 0 0 1px rgba(16, 55, 166, 0.08);
      }
    </style>
  </head>
  <body>
    <main>
      <h1>{title}</h1>
      <p>选择一篇文章进入详情页阅读。</p>
      <ul>
        {posts.map((post) => (
          <li>
            <a href={post.href}>{post.frontmatter.title ?? post.file}</a>
          </li>
        ))}
      </ul>
    </main>
  </body>
</html>
