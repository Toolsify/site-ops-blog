---
export async function getStaticPaths() {
  const modules = import.meta.glob('../../content/posts/**/*.md', { eager: true });
  return Object.entries(modules).map(([file, mod]) => {
    const slugParts = file
      .replace('../../content/posts/', '')
      .replace(/\.md$/, '')
      .split('/');
    return {
      params: { slug: slugParts.join('/') },
      props: { Content: mod.default, frontmatter: mod.frontmatter ?? {} },
    };
  });
}
const { Content, frontmatter } = Astro.props;
const basePath = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <title>{frontmatter.title ?? 'Blog Preview'}</title>
    <style>
      :root {
        color-scheme: light;
        --bg: #fbf8f1;
        --surface: #fffdf8;
        --text: #1d1d1b;
        --muted: #686457;
        --border: #ddd4c2;
        --accent: #1849d6;
        --code-bg: #f3efe5;
      }

      * {
        box-sizing: border-box;
      }

      body {
        margin: 0;
        font-family: "Noto Serif SC", "Songti SC", "STSong", serif;
        background: linear-gradient(180deg, #f6f1e7 0%, var(--bg) 100%);
        color: var(--text);
      }

      main {
        width: min(820px, calc(100vw - 32px));
        margin: 0 auto;
        padding: 28px 0 80px;
      }

      .back-link {
        display: inline-flex;
        align-items: center;
        margin-bottom: 24px;
        color: var(--accent);
        text-decoration: none;
      }

      .back-link:hover {
        text-decoration: underline;
      }

      article {
        padding: clamp(24px, 5vw, 40px);
        border: 1px solid var(--border);
        border-radius: 22px;
        background: var(--surface);
        line-height: 1.85;
        box-shadow: 0 18px 48px rgba(29, 29, 27, 0.06);
      }

      article > :first-child {
        margin-top: 0;
      }

      article > :last-child {
        margin-bottom: 0;
      }

      h1,
      h2,
      h3,
      h4,
      h5,
      h6 {
        margin: 1.8em 0 0.7em;
        line-height: 1.3;
      }

      p,
      ul,
      ol,
      blockquote,
      pre {
        margin: 0 0 1.1em;
      }

      ul,
      ol {
        padding-left: 1.5em;
      }

      a {
        color: var(--accent);
      }

      a:hover {
        color: #1037a6;
      }

      code {
        padding: 0.15em 0.4em;
        border-radius: 6px;
        background: var(--code-bg);
        font-size: 0.92em;
      }

      pre {
        overflow-x: auto;
        padding: 16px;
        border-radius: 14px;
        background: #1f2430;
        color: #f5f7ff;
      }

      pre code {
        padding: 0;
        background: transparent;
        color: inherit;
      }

      blockquote {
        padding-left: 16px;
        border-left: 4px solid rgba(24, 73, 214, 0.25);
        color: var(--muted);
      }

      img {
        max-width: 100%;
        height: auto;
        border-radius: 14px;
      }
    </style>
  </head>
  <body>
    <main>
      <a class="back-link" href={`${basePath}/`}>返回首页</a>
      <article>
        <Content />
      </article>
    </main>
  </body>
</html>
